# Fill in your own provider credentials. Never commit .env.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Replace with a model supported by your provider/account.
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Docker Compose network addresses. See docs/development.md for local Python.
REDIS_PASSWORD=echomind-local-demo
REDIS_URL=redis://:echomind-local-demo@redis:6379/0
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=/app/data/chroma
EVAL_BASELINE_PATH=/app/data/eval/baseline.json
ECHOMIND_SKILLS_DIR=/app/skills
ECHOMIND_SKILLS_MAX_PROMPT_CHARS=5000

LOG_LEVEL=INFO
MONITOR_INTERVAL=10
# Registers Agent/tool metrics; the main API also exposes /metrics.
PROMETHEUS_PORT=9100
ALERT_WEBHOOK_URL=

# Optional evaluation-only startup; /chat stays unavailable and no model is initialized.
ECHOMIND_EVALUATION_ONLY=false
ECHOMIND_EVAL_REPORT_DIR=/app/data/eval/scenarios
# Set a fixed judge model when comparing different agent models.
ECHOMIND_JUDGE_MODEL=
# Independent controls for reproducible retrieval experiments.
ECHOMIND_QUERY_REWRITE_POLICY=always
ECHOMIND_RERANK_POLICY=always
ECHOMIND_RETRIEVAL_TIMEOUT_S=30

# Optional Langfuse v5 exporter. Install requirements-observability.txt separately.
ECHOMIND_TELEMETRY_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
# Content export is a separate opt-in; direct identifiers and credentials remain redacted.
ECHOMIND_TRACE_CONTENT=false
ECHOMIND_TELEMETRY_HASH_SALT=
# auto: legacy HTTP→local fallback; http: strict server; local: explicit persistent DB.
# Isolated scenario evaluation defaults to http unless explicitly overridden.
ECHOMIND_CHROMA_MODE=
# Optional for providers supporting thinking.disabled on structured JSON calls.
# provider_default sends no vendor extension; ordinary Agent replies are unchanged.
ECHOMIND_STRUCTURED_THINKING=provider_default
