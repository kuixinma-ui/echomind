# Local integration only. Generate .env.integration using docs/integration.md.
# Empty secrets deliberately prevent accidental startup of the Compose stack.
INTEGRATION_REDIS_PASSWORD=
INTEGRATION_POSTGRES_PASSWORD=
INTEGRATION_CLICKHOUSE_PASSWORD=
INTEGRATION_LANGFUSE_REDIS_PASSWORD=
INTEGRATION_MINIO_PASSWORD=
INTEGRATION_LANGFUSE_SALT=
INTEGRATION_LANGFUSE_ENCRYPTION_KEY=
INTEGRATION_LANGFUSE_NEXTAUTH_SECRET=

INTEGRATION_REDIS_PORT=16379
INTEGRATION_CHROMA_PORT=18001
INTEGRATION_LANGFUSE_PORT=13000
INTEGRATION_MINIO_PORT=19090

# Host Python endpoints; the app profile overrides these with Docker DNS names.
# Generator fills an explicit URL using the same generated Redis password.
REDIS_URL=
CHROMA_HOST=127.0.0.1
CHROMA_PORT=18001
ECHOMIND_CHROMA_MODE=http
# Local storage/telemetry must bypass the host's outbound HTTP proxy.
NO_PROXY=127.0.0.1,localhost,::1,redis,chromadb,langfuse-web
CHROMA_PERSIST_DIRECTORY=data/chroma-integration-fallback
ECHOMIND_SKILLS_DIR=skills
ECHOMIND_EVAL_REPORT_DIR=data/eval/scenarios

# Fill only in the ignored .env.integration. Keep the Judge fixed in comparisons.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=
ECHOMIND_JUDGE_MODEL=
ECHOMIND_JUDGE_MODE=scores
ECHOMIND_QUERY_REWRITE_POLICY=always
ECHOMIND_RERANK_POLICY=always
ECHOMIND_RETRIEVAL_TIMEOUT_S=30
# Keep provider_default normally; DeepSeek JSON calls may explicitly use disabled.
ECHOMIND_STRUCTURED_THINKING=provider_default

# Enable only after creating a project and its API keys in local Langfuse.
ECHOMIND_TELEMETRY_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:13000
# Optional local headless project; use compose.langfuse-headless.yml.
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_PROJECT_ID=
ECHOMIND_TRACE_CONTENT=false
ECHOMIND_TELEMETRY_HASH_SALT=

# Optional image overrides (use a specific version or digest, never latest).
# INTEGRATION_REDIS_IMAGE=redis:7.4.2-alpine
# INTEGRATION_CHROMA_IMAGE=chromadb/chroma:0.5.23
# INTEGRATION_POSTGRES_IMAGE=postgres:17.6-alpine
# INTEGRATION_CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:25.12
# INTEGRATION_MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:268d68a2a3b6fc65f905a61f84d7eab6345ce6bff14f551e2b028ec31e6a1341
